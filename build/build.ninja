build SDL3/libSDL3_test.a: C_STATIC_LIBRARY_LINKER__SDL3_test_Debug SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_assert.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_common.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_compare.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_crc32.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_font.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_fuzzer.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_harness.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_log.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_md5.c.o SDL3/CMakeFiles/SDL3_test.dir/src/test/SDL_test_memory.c.o
  ARCH_FLAGS = -arch arm64
  CONFIG = Debug
  LANGUAGE_COMPILE_FLAGS = -g
  OBJECT_DIR = SDL3/CMakeFiles/SDL3_test.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = SDL3/libSDL3_test.a
  TARGET_PDB = SDL3_test.a.dbg

